<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.EditarPlaylistPage"
             Title="Editar Playlist"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto,*">
        <!-- Encabezado: nombre + descripción + botones -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="15"
                             Padding="20">

            <Label Text="Editar Playlist"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"/>

            <Entry x:Name="NombreEntry"
                   Placeholder="Nombre de la playlist"
                   TextColor="White"
                   PlaceholderColor="Gray" />

            <Editor x:Name="DescripcionEntry"
                    Placeholder="Descripción de la playlist"
                    TextColor="White"
                    PlaceholderColor="Gray"
                    HeightRequest="80"/>

            <!-- Botones principales -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15">
                <Button Text="Agregar canciones"
                        BackgroundColor="#1DB954"
                        TextColor="Black"
                        CornerRadius="25"
                        Padding="16,8"
                        Clicked="AgregarCanciones_Clicked"/>

                <Button Grid.Column="1"
                        Text="Guardar cambios"
                        BackgroundColor="White"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        Padding="16,8"
                        Clicked="Guardar_Clicked"/>
            </Grid>

            <BoxView HeightRequest="1"
                     Color="#282828"
                     Margin="0,10"/>
        </VerticalStackLayout>

        <!-- Lista de canciones de la playlist -->
        <ScrollView Grid.Row="1">
            <CollectionView x:Name="CancionesActualesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="20,10"
                              ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding NombreCancion}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding NombreArtista}"
                                       TextColor="Gray"
                                       FontSize="14"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="X"
                                    TextColor="Red"
                                    BackgroundColor="Transparent"
                                    FontAttributes="Bold"
                                    Clicked="EliminarCancion_Clicked"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage>
