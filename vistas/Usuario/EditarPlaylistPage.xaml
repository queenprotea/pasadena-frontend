<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.EditarPlaylistPage"
             Title="Editar Playlist"
             BackgroundColor="#121212">

    <ScrollView>
        <Grid RowDefinitions="Auto,*">
            <!-- Encabezado: nombre + descripción + botones -->
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="15"
                                 Padding="5">

                <ImageButton Source="previous_icon.png"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="10,10"
                     HeightRequest="30"
                     WidthRequest="30"
                     BackgroundColor="#33000000"
                     CornerRadius="15"
                     Clicked="BtnVolver_Clicked"
                     ZIndex="99"/>


                <Label Text="Editar Playlist"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Frame CornerRadius="10" 
                    HeightRequest="150" 
                    WidthRequest="150" 
                    Padding="0" 
                    IsClippedToBounds="True"
                    BorderColor="Gray"
                    BackgroundColor="#2c2c2c">
                        <Image x:Name="PlaylistImage" 
                        Aspect="AspectFill"
                        Source="{Binding CoverUrl}"/>
                    </Frame>

                    <Button Text="Subir imagen"
                        TextColor="#1DB954"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        Clicked="SelectImageButton_Clicked"/>

                </VerticalStackLayout>

                <Entry x:Name="NombreEntry"
                       Placeholder="Nombre de la playlist"
                       TextColor="White"
                       PlaceholderColor="Gray" 
                       Text="{Binding Name}"/>

                <Label x:Name="NombreErrorLabel"
                       Text="Campo faltante"
                       TextColor="Red"
                       IsVisible="False" 
                       FontSize="12"/>

                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Playlist Pública" 
                   TextColor="White" 
                   FontSize="16"/>
                        <Label Text="Visible para todos los usuarios" 
                           TextColor="Gray" 
                           FontSize="12"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1" 
                        x:Name="IsPublicSwitch"
                        OnColor="#1DB954"
                        ThumbColor="White"/>
                </Grid>


                <!-- Botones principales -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="15">
                    <Button Text="Agregar canciones"
                            BackgroundColor="#1DB954"
                            TextColor="Black"
                            CornerRadius="25"
                            Padding="16,8"
                            Clicked="AgregarCanciones_Clicked"/>

                    <Button Grid.Column="1"
                            Text="Guardar cambios"
                            BackgroundColor="White"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            Padding="16,8"
                            Clicked="Guardar_Clicked"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Color="#282828"
                         Margin="0,10"/>
            </VerticalStackLayout>

            <!-- Lista de canciones de la playlist -->
            <ScrollView Grid.Row="1">
                <CollectionView x:Name="CancionesActualesCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,10"
                                  ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding NombreCancion}"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding NombreArtista}"
                                           TextColor="Gray"
                                           FontSize="14"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="X"
                                        TextColor="Red"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        Clicked="EliminarCancion_Clicked"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>
    </ScrollView>
</ContentPage>