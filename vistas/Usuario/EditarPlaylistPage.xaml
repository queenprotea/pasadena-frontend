<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.EditarPlaylistPage"
             Title="Editar Playlist"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Spacing="15" Padding="20">

            <Label Text="Editar Playlist" TextColor="White" FontSize="24" FontAttributes="Bold"/>

            <Entry x:Name="NombreEntry" Placeholder="Nombre de la playlist" TextColor="White" PlaceholderColor="Gray" />
            <Editor x:Name="DescripcionEntry" Placeholder="Descripción (opcional)" TextColor="White" PlaceholderColor="Gray" HeightRequest="80"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Grid.Column="0" Text="Guardar Cambios" BackgroundColor="White" TextColor="Black" CornerRadius="20" Clicked="Guardar_Clicked"/>
                <Button Grid.Column="1" Text="Agregar Canciones" BackgroundColor="#282828" TextColor="White" CornerRadius="20" Clicked="AgregarCanciones_Clicked"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#282828" Margin="0,10"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <CollectionView x:Name="CancionesActualesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="20,10" ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding NombreCancion}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding NombreArtista}" TextColor="Gray" FontSize="14"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="X" 
                                    TextColor="Red"
                                    BackgroundColor="Transparent"
                                    FontAttributes="Bold"
                                    Clicked="EliminarCancion_Clicked"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage>