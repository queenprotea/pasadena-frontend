<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.EditarPerfilPage"
             Title="Editar Información Personal"
             BackgroundColor="#121212">

    <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Start">

        <Label Text="Foto de Perfil"
               TextColor="White"
               FontSize="18"
               FontAttributes="Bold"/>

        <Frame HorizontalOptions="Center" 
               HeightRequest="120" 
               WidthRequest="120" 
               CornerRadius="60" 
               IsClippedToBounds="True"
               Padding="0">
            <Image x:Name="ProfileImage" 
                   Source="user_profile_icon.png" 
                   Aspect="AspectFill"/>
        </Frame>

        <Button Text="Cambiar foto"
                BackgroundColor="#282828"
                TextColor="White"
                CornerRadius="20"
                HorizontalOptions="Center"/>

        <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

        <Label Text="Nombre de usuario" TextColor="Gray"/>
        <Entry x:Name="UsernameEntry" 
               Placeholder="Tu nombre de usuario" 
               TextColor="White" 
               PlaceholderColor="Gray" />

        <Label Text="Nombre completo" TextColor="Gray" Margin="0,10,0,0"/>
        <Entry x:Name="FullNameEntry" 
               Placeholder="Tu nombre completo" 
               TextColor="White" 
               PlaceholderColor="Gray" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,30,0,0">

            <Button Grid.Column="0"
                    x:Name="CancelButton"
                    Text="Cancelar"
                    BackgroundColor="#535353"
                    TextColor="White"
                    CornerRadius="25"/>

            <Button Grid.Column="1"
                    x:Name="SaveChangesButton"
                    Text="Guardar cambios"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="25"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>