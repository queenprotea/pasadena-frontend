<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.CrearPlaylistPage"
             Title="Crear nueva playlist"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Start" Margin="0,10,0,0">

            <Label Text="Crea tu playlist"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Frame CornerRadius="10" 
                       HeightRequest="150" 
                       WidthRequest="150" 
                       Padding="0" 
                       IsClippedToBounds="True"
                       BorderColor="Gray"
                       BackgroundColor="#2c2c2c">
                    <Image x:Name="PlaylistImage" 
                           Aspect="AspectFill"
                           Source="music_placeholder.png"/>
                </Frame>

                <Button Text="Subir imagen"
                        TextColor="#1DB954"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        Clicked="SelectImageButton_Clicked"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Nombre" TextColor="Gray"/>
                <Entry x:Name="NombreEntry" 
                       Placeholder="El nombre de tu playlist" 
                       TextColor="White" 
                       PlaceholderColor="Gray" />

                <Label x:Name="NombreErrorLabel"
                       Text="Campo faltante"
                       TextColor="Red"
                       IsVisible="False" 
                       FontSize="12"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Playlist Pública" 
                           TextColor="White" 
                           FontSize="16"/>
                    <Label Text="Visible para todos los usuarios" 
                           TextColor="Gray" 
                           FontSize="12"/>
                </VerticalStackLayout>

                <Switch Grid.Column="1" 
                        x:Name="IsPublicSwitch"
                        OnColor="#1DB954"
                        ThumbColor="White"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,30,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        BackgroundColor="#535353"
                        TextColor="White"
                        CornerRadius="25"
                        Clicked="CancelButton_Clicked"/>

                <Button Grid.Column="1"
                        Text="Aceptar"
                        BackgroundColor="White"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        Clicked="AcceptButton_Clicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>