<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.PantallaInicio"
             BackgroundColor="#050509">

    <ContentPage.Resources>
        <!-- Estilos básicos -->
        <Style TargetType="Label" x:Key="TitleLabel">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BackgroundColor" Value="#1DB954" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BackgroundColor" Value="#181818" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="220,*">

        <!-- ================= CABECERA (fila 0, columnas 0-1) ================= -->
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Padding="16"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#121212"
              VerticalOptions="Center">

            <!-- Botón menú (por ahora solo decorativo, pero con handler por si lo quieres usar) -->
            <Button Text="☰"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#262626"
                    TextColor="White"
                    CornerRadius="20"
                    Clicked="ToggleMenu_Clicked"/>

            <!-- Buscador -->
            <SearchBar x:Name="SearchBar"
                       Grid.Column="1"
                       Margin="16,0"
                       Placeholder="¿Qué quieres escuchar?"
                       BackgroundColor="#262626"
                       TextColor="White"
                       PlaceholderColor="#888888"
                       SearchButtonPressed="SearchSong_Clicked"
                       TextChanged="SearchSong_TextChanged"/>

            <ImageButton Grid.Column="2"
             Source="default_user.png"
             BackgroundColor="#1E1E1E"
             WidthRequest="44"
             HeightRequest="44"
             Padding="4"
             CornerRadius="22"
             Clicked="ProfileButton_Clicked"/>
            
        </Grid>

        <!-- ================= MENÚ LATERAL (fila 1, columna 0) ================= -->
        <ScrollView Grid.Row="1"
                    Grid.Column="0">
            <VerticalStackLayout x:Name="LeftMenu"
                                 Padding="16"
                                 Spacing="16"
                                 BackgroundColor="#000000">

                <Button Text="+ Crear Playlist"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="CrearPlaylist_Clicked"/>

                <Label Text="TU BIBLIOTECA"
                       TextColor="#B0B0B0"
                       FontSize="12"
                       FontAttributes="Bold"/>

                <!-- LISTA DE PLAYLISTS -->
                <CollectionView x:Name="PlaylistsCollection"
                                ItemsSource="{Binding Playlists}"
                                SelectionMode="Single"
                                SelectionChanged="PlaylistsCollection_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding DisplayName}"
                                   TextColor="White"
                                   FontSize="14"
                                   Padding="4,2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="PANEL DE ADMIN"
                       Margin="0,16,0,0"
                       TextColor="#B0B0B0"
                       FontSize="12"
                       FontAttributes="Bold"/>

                <Button Text="Ver Estadísticas"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="AdminStats_Clicked"/>

                <Button Text="Gestionar Canciones"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="AdminCanciones_Clicked"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= CONTENIDO PRINCIPAL (fila 1, columna 1) ================= -->
        <ScrollView Grid.Row="1"
                    Grid.Column="1">
            <VerticalStackLayout Padding="24"
                                 Spacing="24">

                <!-- Sección de recomendaciones -->
                <Label Text="Esto puede gustarte"
                       Style="{StaticResource TitleLabel}"/>

                <CollectionView x:Name="AlbumsCollection"
                                HeightRequest="220"
                                ItemsSource="{Binding AlbumsRecomendados}"
                                SelectionMode="Single"
                                SelectionChanged="OnAlbumSelected">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="20"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout WidthRequest="160">
                                <Frame CornerRadius="12"
                                       HasShadow="False"
                                       Padding="0"
                                       HeightRequest="160"
                                       WidthRequest="160">
                                    <Image Source="{Binding CoverUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="160"
                                           WidthRequest="160"/>
                                </Frame>

                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,8,0,0"/>

                                <Label Text="{Binding Artist}"
                                       TextColor="#B0B0B0"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Resultados de búsqueda -->
                <Label Text="Resultados de búsqueda"
                       Style="{StaticResource TitleLabel}"/>

                <CollectionView x:Name="SearchResultsView"
                                IsVisible="False"
                                ItemsSource="{Binding SearchResults}"
                                SelectionMode="Single"
                                SelectionChanged="OnSearchResultSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8"
                                  ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Nombre}"
                                       TextColor="White"
                                       FontSize="14"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Tipo}"
                                       TextColor="#B0B0B0"
                                       FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= REPRODUCTOR INFERIOR (fila 2, columnas 0-1) ================= -->
        <Grid Grid.Row="2"
              Grid.ColumnSpan="2"
              BackgroundColor="#101010"
              Padding="20"
              ColumnDefinitions="*,Auto,Auto,Auto,*"
              VerticalOptions="Center">

            <!-- Espacio a la izquierda -->

            <!-- Botón retroceder -->
            <ImageButton Grid.Column="1"
             Source="icon_prev.png"
             BackgroundColor="Transparent"
             HeightRequest="36"
             WidthRequest="36"
             Padding="0"
             Clicked="PreviousButton_Clicked"/>

            <!-- Botón play / pausa -->
            <ImageButton Grid.Column="2"
             x:Name="PlayPauseButton"
             Source="icon_play.png"
             BackgroundColor="Transparent"
             HeightRequest="42"
             WidthRequest="42"
             Padding="0"
             Clicked="PlayPause_Clicked"/>

            <!-- Botón siguiente -->
            <ImageButton Grid.Column="3"
             Source="icon_next.png"
             BackgroundColor="Transparent"
             HeightRequest="36"
             WidthRequest="36"
             Padding="0"
             Clicked="NextButton_Clicked"/>


            <!-- Espacio a la derecha -->
        </Grid>
    </Grid>
</ContentPage>
