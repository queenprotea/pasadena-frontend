<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.PantallaInicio"
             BackgroundColor="#050509">

    <ContentPage.Resources>
        <!-- Estilos básicos -->
        <Style TargetType="Label" x:Key="TitleLabel">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BackgroundColor" Value="#1DB954" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BackgroundColor" Value="#181818" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="220,*">

        <!-- ================= CABECERA ================= -->
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Padding="16"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#121212"
              VerticalOptions="Center">

            <!-- Botón menú -->
            <Button Text="☰"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#262626"
                    TextColor="White"
                    CornerRadius="20"
                    Clicked="ToggleMenu_Clicked"/>

            <!-- Buscador -->
            <SearchBar x:Name="SearchBar"
                       Grid.Column="1"
                       Margin="16,0"
                       Placeholder="¿Qué quieres escuchar?"
                       BackgroundColor="#262626"
                       TextColor="White"
                       PlaceholderColor="#888888"
                       SearchButtonPressed="SearchSong_clicked"
                       TextChanged="SearchSong_textChanged"/>

            <ImageButton Grid.Column="2"
                       BackgroundColor="Black"
                       Source="default_user.png"
                       HeightRequest="40"
                       WidthRequest="40"
                       Aspect="AspectFill"
                       CornerRadius="20"
                       Margin="10,0,0,0"
                       x:Name="ProfileButton"
                       Clicked="ProfileButton_Clicked"/>

        </Grid>

        <!-- ================= MENÚ LATERAL  ================= -->
        <ScrollView x:Name="MenuLateral" Grid.Row="1"
                    Grid.Column="0" IsVisible="True">
            <VerticalStackLayout x:Name="LeftMenu"
                                 Padding="16"
                                 Spacing="16"
                                 BackgroundColor="#000000"
                                 IsVisible="True">

                <Button Text="+ Crear Playlist"
                        Style="{StaticResource PrimaryButton}"
                        x:Name="CreatePlaylistButton"
                        Clicked="CrearPlaylist_Clicked"/>

                <Label Text="TU BIBLIOTECA"
                       TextColor="#B0B0B0"
                       FontSize="12"
                       FontAttributes="Bold"/>

                <!-- LISTA DE PLAYLISTS -->
                <CollectionView x:Name="PlaylistsCollection"
                                ItemsSource="{Binding Playlists}"
                                SelectionMode="Single"
                                SelectionChanged="PlaylistsCollection_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding DisplayName}"
                                   TextColor="White"
                                   FontSize="14"
                                   Padding="4,2" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="PANEL DE ADMIN"
                       Margin="0,16,0,0"
                       TextColor="#B0B0B0"
                       FontSize="12"
                       FontAttributes="Bold"/>

                <Button Text="Ver Estadísticas"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="AdminStats_Clicked"
                        IsVisible="False"
                        x:Name="EstadisticasButton"/>

                <Button Text="Gestionar Canciones"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="AdminCanciones_Clicked"
                        IsVisible="False"
                        x:Name="GestionCancionesButton"/>

            </VerticalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="1"
                    Grid.Column="1">
            <VerticalStackLayout Padding="24"
                                 Spacing="24">

                <!-- Resultados de búsqueda -->
                <Label Text="Resultados de búsqueda"
                Style="{StaticResource TitleLabel}"/>

                <CollectionView x:Name="SearchResultsView"
                IsVisible="False"
                ItemsSource="{Binding SearchResults}"
                SelectionMode="Single"
                SelectionChanged="OnSearchResultSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8"
                  ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Nombre}"
                       TextColor="White"
                       FontSize="14"/>
                                <Label Grid.Column="1"
                       Text="{Binding Tipo}"
                       TextColor="#B0B0B0"
                       FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <VerticalStackLayout x:Name="TopSongsSection"
                     IsVisible="False"
                     Spacing="12">

                    <Label Text="Tus canciones más escuchadas"
       Style="{StaticResource TitleLabel}"/>

                <CollectionView ItemsSource="{Binding TopSongsInicio}"
                HeightRequest="120"
                SelectionMode="Single"
                SelectionChanged="OnTopSongSelected">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                           ItemSpacing="16"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="220"
                  Padding="8"
                  ColumnDefinitions="60,*">

                                <Image Source="song_icon.png"
                       HeightRequest="48"
                       WidthRequest="48"
                       VerticalOptions="Center"/>

                                <StackLayout Grid.Column="1"
                             VerticalOptions="Center"
                             Padding="8,0">

                                    <Label Text="{Binding title}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14"
                           LineBreakMode="TailTruncation"/>

                                    <Label Text="{Binding artist}"
                           TextColor="#B0B0B0"
                           FontSize="12"
                           LineBreakMode="TailTruncation"/>
                                </StackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </VerticalStackLayout>


                <!-- Sección de recomendaciones -->
                <Label Text="Esto puede gustarte"
                       Style="{StaticResource TitleLabel}"/>
                <Label Text="ALbums"
       TextColor="White"
       FontAttributes="Bold"
       FontSize="14"
       LineBreakMode="TailTruncation"
       Margin="0,8,0,0"/>

                <CollectionView x:Name="AlbumsCollection"
                                HeightRequest="220"
                                ItemsSource="{Binding AlbumsRecomendados}"
                                SelectionMode="Single"
                                SelectionChanged="OnAlbumSelected">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="20"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout WidthRequest="160">
                                <Frame CornerRadius="12"
                                       HasShadow="False"
                                       Padding="0"
                                       HeightRequest="160"
                                       WidthRequest="160">
                                    <Image Source="{Binding CoverUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="160"
                                           WidthRequest="160"/>
                                </Frame>

                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,8,0,0"/>

                                <Label Text="{Binding Artist}"
                                       TextColor="#B0B0B0"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Canciones recomendadas -->
                <!-- Canciones recomendadas -->
                <Label Text="Canciones"
       TextColor="White"
       FontAttributes="Bold"
       FontSize="14"
       LineBreakMode="TailTruncation"
       Margin="0,8,0,0"/>
                <CollectionView x:Name="SongsCollection"
                HeightRequest="120"
                ItemsSource="{Binding SongsRecomendadas}"
                SelectionMode="Single"
                SelectionChanged="OnSongRecommendationSelected">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                           ItemSpacing="16"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="220"
                  Padding="8"
                  ColumnDefinitions="60,*">

                                <Image Source="song_icon.png"
                       HeightRequest="48"
                       WidthRequest="48"
                       VerticalOptions="Center"/>

                                <StackLayout Grid.Column="1"
                             Padding="8,0"
                             VerticalOptions="Center">

                                    <Label Text="{Binding title}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14"
                           LineBreakMode="TailTruncation"/>

                                    <Label Text="{Binding artist}"
                           TextColor="#B0B0B0"
                           FontSize="12"
                           LineBreakMode="TailTruncation"/>
                                </StackLayout>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


            </VerticalStackLayout>
        </ScrollView>
        
        <Grid Grid.Row="2"
      Grid.ColumnSpan="2"
      BackgroundColor="#101010"
      Padding="20"
      VerticalOptions="Center">

            <HorizontalStackLayout HorizontalOptions="Start"
                           VerticalOptions="Center"
                           Spacing="10">
               
                <StackLayout Spacing="2" VerticalOptions="Center">
                    <Label x:Name="SongName"
                   Text="Nombre de la canción"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="14"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"/>
                    <Label x:Name="SongArtist"
                   Text="Nombre del artista"
                   TextColor="Gray"
                   FontSize="12"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"/>
                </StackLayout>
            </HorizontalStackLayout>

          
            <HorizontalStackLayout x:Name="ButtomStack" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="10">
                <ImageButton Source="icon_prev.png"
                     BackgroundColor="Transparent"
                     HeightRequest="36"
                     WidthRequest="36"
                     Clicked="PreviousButton_Clicked"/>
                <ImageButton x:Name="PlayPauseButton"
                     Source="icon_play.png"
                     BackgroundColor="Transparent"
                     HeightRequest="42"
                     WidthRequest="42"
                     Clicked="PlayPause_Clicked"/>
                <ImageButton Source="icon_next.png"
                     BackgroundColor="Transparent"
                     HeightRequest="36"
                     WidthRequest="36"
                     Clicked="NextButton_Clicked"/>
            </HorizontalStackLayout>
        </Grid>



    </Grid>
</ContentPage>