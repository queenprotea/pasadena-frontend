<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.Login.InicioSesion"
             Title="InicioSesion">
    <ScrollView>

        <VerticalStackLayout Padding="25" Spacing="20" VerticalOptions="Center">
            <!-- Header -->
            <Label Text="Iniciar sesión"
                   TextColor="Black"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0, 0, 0, 10"/>

            <Label Text="Inicia sesión para acceder a Pasadena" 
                   TextColor="Gray" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,30"/>

            <!-- Login Form -->
            <Frame BackgroundColor="#1E1E1E" 
                   BorderColor="#333333" 
                   CornerRadius="15" 
                   Padding="25" 
                   Margin="0,0,0,20">

                <VerticalStackLayout Spacing="20">

                    <!-- Identifier Input -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo/nombre de usuario" 
                               TextColor="White" 
                               FontSize="14" 
                               FontAttributes="Bold"/>

                        <Entry x:Name="IdentifierEntry" 
                               Placeholder="Ingresa tu correo o nombre de usuario" 
                               TextColor="White" 
                               PlaceholderColor="#888888"
                               BackgroundColor="#2A2A2A"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" 
                               TextColor="White" 
                               FontSize="14" 
                               FontAttributes="Bold"/>

                        <Entry x:Name="PasswordEntry" 
                               Placeholder="Ingresa tu contraseña" 
                               TextColor="White" 
                               PlaceholderColor="#888888"
                               BackgroundColor="#2A2A2A"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label x:Name="ErrorLabel" 
                           Text="" 
                           TextColor="#FF6B6B" 
                           FontSize="14" 
                           IsVisible="False"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton" 
                            Text="Inicia sesión" 
                            BackgroundColor="#1DB954" 
                            TextColor="White" 
                            CornerRadius="25" 
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Clicked="btnLoginClick"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Footer Links -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label Text="¿No tienes una cuenta?" 
                       TextColor="Gray" 
                       FontSize="14"
                       Margin="0, 8, 0, 10"/>

                <Button x:Name="btnRegistro"
                        Text="Registrate"
                        BackgroundColor="Transparent"
                        TextColor="#1DB954"
                        CornerRadius="22"
                        FontSize="14"
                        FontAttributes="Italic"
                        Clicked="btnRegistro_Clicked"
                        Margin="0, -4, 0, 0"/>
            </HorizontalStackLayout>
            <Button Text="Olvidaste tu contraseña?"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontSize="12"
                    FontAttributes="Italic"
                    Clicked="btnModificarContrasena"
                    Margin="0, 0, 0, 0"/>
        </VerticalStackLayout>
        
    </ScrollView>
</ContentPage>