<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Usuario.AlbumPage"
             Title="Album"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <!-- GRID PRINCIPAL 3 FILAS -->
    <Grid RowDefinitions="*,1,85">

        <!-- ===================================================== -->
        <!-- ===============   FILA PRINCIPAL (ALBUM)   ========== -->
        <!-- ===================================================== -->
        <Grid Grid.Row="0">
            <BoxView VerticalOptions="Start" HeightRequest="350">
                <BoxView.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="{Binding PrimaryColor}" Offset="0.0" />
                        <GradientStop Color="#121212" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <ImageButton Source="previous_icon.png"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         Margin="15,20"
                         HeightRequest="30"
                         WidthRequest="30"
                         BackgroundColor="#33000000"
                         CornerRadius="15"
                         Clicked="BtnVolver_Clicked"
                         ZIndex="99"/>

            <CollectionView x:Name="SongsList"
                            ItemsSource="{Binding Songs}"
                            SelectionMode="Single"
                            SelectionChanged="Song_SelectionChanged">

                <CollectionView.Header>
                    <VerticalStackLayout Padding="20" Spacing="10">

                        <Border 
                            StrokeShape="RoundRectangle 5"
                                StrokeThickness="0"
                                HeightRequest="220"
                                WidthRequest="220"
                                HorizontalOptions="Center"
                                Margin="0,30,0,10">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.6"/>
                            </Border.Shadow>
                            <Image Source="{Binding CoverUrl}" Aspect="AspectFill"/>
                        </Border>

                        <Label Text="{Binding Name}" 
                               TextColor="White" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Start"/>

                        <HorizontalStackLayout Spacing="5">
                            <Image Source="user_profile_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Artist}" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="•" TextColor="Gray" VerticalOptions="Center"/>
                            <Label Text="{Binding Year}" TextColor="Gray" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,10">
                            <VerticalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End">

                                <!-- Botón de Play -->
                                <Button 
            Text="▶"
            FontSize="20"
            TextColor="Black"
            BackgroundColor="#1ED760"
            HeightRequest="55"
            WidthRequest="55"
            CornerRadius="28"
            Clicked="PlayButton_Clicked"/>

                                <!-- NUEVO BOTÓN -->
                                <Button 
            x:Name="AdminButton"
            Text="Opciones"
            FontAttributes="Bold"
            FontSize="14"
            BackgroundColor="#333333"
            TextColor="White"
            HeightRequest="40"
            WidthRequest="110"
            CornerRadius="12"
            HorizontalOptions="Center"
            IsVisible="false" />
                                <!-- Esta propiedad controla si se muestra -->
                            </VerticalStackLayout>



                            <Label Grid.Column="0" Text="Descargar" TextColor="Gray" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="30, *, Auto" Padding="20,10" ColumnSpacing="10">

                            <Label Grid.Column="0" 
                                   Text="{Binding songNumber}" 
                                   TextColor="Gray" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding title}" 
                                       TextColor="White" 
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding artist}" 
                                       TextColor="Gray" 
                                       FontSize="13"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="2" 
                                   Text="..." 
                                   TextColor="Gray" 
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   Rotation="90"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>


        <!-- ===================================================== -->
        <!-- ================  DIVISOR (1PX)   =================== -->
        <!-- ===================================================== -->
        <BoxView Grid.Row="1"
                 HeightRequest="1"
                 BackgroundColor="#1E1E1E"/>


        <!-- ===================================================== -->
        <!-- ===== REPRODUCTOR INFERIOR (FILA 2, BARRA) =========== -->
        <!-- ===================================================== -->
        <Grid Grid.Row="2"
              BackgroundColor="#101010"
              Padding="20"
              ColumnDefinitions="*,Auto,Auto,Auto,*"
              VerticalOptions="Center">

            <HorizontalStackLayout Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Spacing="10">

                <Image x:Name="CurrentSongImage"
                       Source="current_song_art.png"
                       HeightRequest="50" WidthRequest="50"
                       Aspect="AspectFill"
                       Margin="0,0,10,0"/>

                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="SongName"
                           Text="Nombre de la canción"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14"/>

                    <Label x:Name="SongArtist"
                           Text="Nombre del artista"
                           TextColor="Gray"
                           FontSize="12"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>

            <!-- Botón retroceder -->
            <ImageButton Grid.Column="1"
                         Source="icon_prev.png"
                         BackgroundColor="Transparent"
                         HeightRequest="36"
                         WidthRequest="36"
                         Padding="0"
                         Clicked="PreviousButton_Clicked"/>

            <!-- Botón play / pausa -->
            <ImageButton Grid.Column="2"
                         x:Name="PlayPauseButton"
                         Source="icon_play.png"
                         BackgroundColor="Transparent"
                         HeightRequest="42"
                         WidthRequest="42"
                         Padding="0"
                         Clicked="PlayPause_Clicked"/>

            <!-- Botón siguiente -->
            <ImageButton Grid.Column="3"
                         Source="icon_next.png"
                         BackgroundColor="Transparent"
                         HeightRequest="36"
                         WidthRequest="36"
                         Padding="0"
                         Clicked="NextButton_Clicked"/>

        </Grid>

    </Grid>

</ContentPage>
