<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Administrador.AdminDashboardPage"
             Title="Estadísticas"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- Título principal -->
            <Label Text="Resumen de la actividad"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,10,0,10" />

            <!-- Tarjetas de estadísticas -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="15"
                  RowSpacing="15">

                <!-- Tiempo total reproducido -->
                <Border Grid.Row="0" Grid.Column="0"
                        Stroke="#333333"
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="Tiempo total reproducido (min)"
                               TextColor="Gray"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Label x:Name="lblTotalUsuarios"
                               Text="-"
                               TextColor="White"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Total de canciones escuchadas -->
                <Border Grid.Row="0" Grid.Column="1"
                        Stroke="#333333"
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="Total de canciones escuchadas"
                               TextColor="Gray"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Label x:Name="lblTotalCanciones"
                               Text="-"
                               TextColor="White"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Género más escuchado -->
                <Border Grid.Row="1" Grid.Column="0"
                        Stroke="#333333"
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="Género más escuchado"
                               TextColor="Gray"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Label x:Name="lblTopGenero"
                               Text="-"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Canciones en tu Top -->
                <Border Grid.Row="1" Grid.Column="1"
                        Stroke="#333333"
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="Canciones en tu Top"
                               TextColor="Gray"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Label x:Name="lblTotalPlaylists"
                               Text="-"
                               TextColor="White"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Artistas en tu Top -->
                <Border Grid.Row="2" Grid.ColumnSpan="2"
                        Stroke="#333333"
                        BackgroundColor="#1E1E1E"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="15" Spacing="5">
                        <Label Text="Artistas en tu Top"
                               TextColor="Gray"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <Label x:Name="lblTotalArtistas"
                               Text="-"
                               TextColor="White"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Botón Volver -->
            <Button Text="Volver al inicio"
                    BackgroundColor="#222222"
                    TextColor="Gray"
                    Margin="0,20,0,0"
                    Clicked="Volver_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
