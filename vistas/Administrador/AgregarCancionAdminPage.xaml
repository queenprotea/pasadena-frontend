<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pasadena_vistas.vistas.Administrador.AgregarCancionAdminPage"
             Title="Agregar Canción"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="25" VerticalOptions="Start" Margin="0,20,0,0">
            <Label Text="Agregar Nueva Canción" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Label Text="Título (Nombre de la canción)" TextColor="Gray" Margin="0,20,0,0"/>
            <Entry x:Name="NombreEntry" Placeholder="Nombre de la canción" TextColor="White" />

            <Label Text="Artista" TextColor="Gray" Margin="0,10,0,0"/>
            <Entry x:Name="ArtistaEntry" Placeholder="Nombre del artista" TextColor="White" />

            <Label Text="Álbum" TextColor="Gray" Margin="0,10,0,0"/>
            <Entry x:Name="AlbumEntry" Placeholder="Nombre del álbum" TextColor="White" />

            <Label Text="Género" TextColor="Gray" Margin="0,10,0,0"/>
            <Entry x:Name="GeneroEntry" Placeholder="Ej: Rock, Pop, Indie" TextColor="White" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Número de Pista" TextColor="Gray"/>
                    <Entry x:Name="PistaEntry" Keyboard="Numeric" Placeholder="Ej: 1" TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Duración" TextColor="Gray"/>
                    <Entry x:Name="DuracionEntry" Placeholder="Ej: 3:45" TextColor="White" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="URL del archivo de audio (MP3)" TextColor="Gray" Margin="0,10,0,0"/>
            <Entry x:Name="UrlAudioEntry" Placeholder="https://.../cancion.mp3" TextColor="White" />

            <Label Text="URL de la carátula (Imagen)" TextColor="Gray" Margin="0,10,0,0"/>
            <Entry x:Name="UrlCaratulaEntry" Placeholder="https://.../cover.jpg" TextColor="White" />


            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,30,0,0">
                <Button Grid.Column="0" Text="Cancelar" BackgroundColor="#535353" CornerRadius="25" Clicked="Cancelar_Clicked"/>
                <Button Grid.Column="1" Text="Guardar Canción" BackgroundColor="#28a745" CornerRadius="25" FontAttributes="Bold" Clicked="Guardar_Clicked"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>